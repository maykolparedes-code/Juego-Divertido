<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ControlFamiliar" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Tema de la pantalla de bloqueo por límite de tiempo: a pantalla
         completa, sin barra de estado, para que el mensaje sea inequívoco. -->
