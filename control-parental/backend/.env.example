# Copia este archivo a .env y completa los valores antes de correr el backend.

# Cadena de conexión a PostgreSQL (no se usa aún en este scaffold: la
# persistencia con Prisma está marcada como "Implementación real" en los
# servicios; el servidor arranca igual sin ella para poder probar la API).
DATABASE_URL="postgresql://user:password@localhost:5432/control_familiar"

# Secreto para firmar los JWT de sesión. En desarrollo puede ser cualquier
# cadena; en producción debe salir de un gestor de secretos.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Clave AES-256 en base64 (32 bytes) para cifrar lat/lng en reposo.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCATION_ENCRYPTION_KEY=""

# Orígenes permitidos por CORS, separados por coma.
ALLOWED_ORIGINS="http://localhost:3000"

PORT=3000
